generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id              String   @id @default(uuid())
  studentName     String
  phoneNumber     String
  fatherName      String
  fatherPhone     String
  gender          String   // MALE, FEMALE
  usn             String   @unique
  department      String
  yearSem         String
  dob             DateTime
  address         String
  email           String
  category        String?
  hostelPref      String
  quota           String?
  rank            String?
  bloodGroup      String?
  nationality     String?
  religion        String?
  aadhaar         String?
  fatherOcc       String?
  motherOcc       String?
  allergies       String?
  medication      String?
  medicalInfo     String?
  emergencyContact String
  remarks         String?
  status          String   // PENDING, HOLD, APPROVED, REJECTED
  holdReason      String?
  appliedAt       DateTime @default(now())
  bmsitId         String?
  fatherEmail     String?
  motherEmail     String?
  guardianEmail   String?
  motherName      String?
  motherPhone     String?
  guardianName    String?
  guardianPhone   String?
  studentEmailSent   Boolean?  @default(false)
  fatherEmailSent    Boolean?  @default(false)
  motherEmailSent    Boolean?  @default(false)
  studentEmailSentAt DateTime?
  fatherEmailSentAt  DateTime?
  motherEmailSentAt  DateTime?

  allocations     Allocation[]
  documents       Document[]
}

model Document {
  id            String   @id @default(uuid())
  applicationId String
  name          String
  url           String
  application   Application @relation(fields: [applicationId], references: [id])
}

model Block {
  id       String  @id @default(uuid())
  name     String
  gender   String  // MALE, FEMALE
  imageUrl String?
  rooms    Room[]
}

model Room {
  id       String  @id @default(uuid())
  blockId  String
  roomNo   String
  floor    Int
  capacity Int
  type     String  // e.g., "4 Sharing"
  block    Block   @relation(fields: [blockId], references: [id])
  beds     Bed[]
}

model Bed {
  id          String   @id @default(uuid())
  roomId      String
  bedNo       Int
  status      String   // AVAILABLE, OCCUPIED, RESERVED, MAINTENANCE
  room        Room     @relation(fields: [roomId], references: [id])
  allocation  Allocation?
}

model Allocation {
  id            String   @id @default(uuid())
  applicationId String
  bedId         String   @unique
  allocatedAt   DateTime @default(now())
  status        String   // ACTIVE, CANCELLED, TRANSFERRED
  
  application   Application @relation(fields: [applicationId], references: [id])
  bed           Bed         @relation(fields: [bedId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  adminName   String
  action      String
  details     String
  createdAt   DateTime @default(now())
}

model AllocationHistory {
  id              String   @id @default(uuid())
  studentName     String
  previousBlock   String?
  previousRoom    String?
  previousBed     String?
  newBlock        String
  newRoom         String
  newBed          String
  adminName       String
  reason          String?
  createdAt       DateTime @default(now())
}

model Payment {
  id              String    @id @default(uuid())
  studentName     String
  studentUsn      String
  hostelName      String
  block           String
  floor           String?
  roomNumber      String
  utrNumber       String    @unique
  paymentDate     DateTime
  screenshotUrl   String?
  status          String    @default("PENDING_REVIEW")
  emailStatus     String    @default("PENDING")
  reviewedBy      String?
  reviewedAt      DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}


model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Facility {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model FeedbackCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Feedback {
  id          String   @id @default(uuid())
  studentName String?
  usn         String?
  periodName  String
  ratings     String   // JSON string: { "Mess Food": 5, "WiFi": 4 }
  comments    String?
  createdAt   DateTime @default(now())
}

model Complaint {
  id          String   @id @default(uuid())
  studentName String
  usn         String
  roomNo      String
  category    String
  description String
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

model SocialPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  author      String
  type        String   @default("General")
  createdAt   DateTime @default(now())
}

model LeaveApplication {
  id          String   @id @default(uuid())
  studentName String
  usn         String
  reason      String
  fromDate    DateTime
  toDate      DateTime
  status      String   @default("Pending")
  appliedAt   DateTime @default(now())
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  desc        String
  date        String
  category    String
  priority    String
  author      String
  fileSize    String?
  createdAt   DateTime @default(now())
}

model EmailHistory {
  id          String   @id @default(uuid())
  studentId   String
  studentName String
  usn         String
  email       String
  workflow    String
  subject     String
  body        String
  status      String
  mode        String
  createdAt   DateTime @default(now())
}

model SocialGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  iconName  String
  desc      String
  badge     String?
  createdAt DateTime @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id          String   @id @default(uuid())
  groupId     String
  senderName  String
  usn         String
  roomNo      String
  message     String
  time        String
  likes       Int      @default(0)
  categoryTag String?
  price       String?
  imgUrl      String?
  createdAt   DateTime @default(now())

  group       SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}